{% extends 'layout.html.twig' %}

{% block title %}{{ task.title }} · Tasks · {{ parent() }}{% endblock %}

{% block band %}
    <section class="wf-band">
        <div class="container-xl py-5">
            <a class="wf-back small" href="{{ path('task_index') }}">← All tasks</a>
            <p class="wf-kicker mt-4 mb-2">State machine · task #{{ task.id }}</p>
            <h1 class="wf-page-title mb-3">{{ task.title }}</h1>
            <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                <span class="wf-muted small">Current place</span>
                {% for place in workflow_marked_places(task) %}
                    <span class="wf-place is-marked">{{ place }}</span>
                {% endfor %}
            </div>
            <p class="wf-muted mb-0 col-lg-8">{{ workflow_metadata(task, 'description') }}</p>
        </div>
    </section>
{% endblock %}

{% block main %}
    <div class="card mb-4">
        <div class="card-header">Diagram</div>
        <div class="card-body">
            <div class="wf-diagram" {{ stimulus_controller('mermaid', {definition: workflow_dump('task', 'statemachine', task)})|stimulus_action('mermaid', 'keep', 'turbo:before-morph-element') }}></div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            {{ include('include/transitions.html.twig', {
                subject: task,
                workflow: 'task',
                action: path('task_apply_transition', {id: task.id}),
            }) }}
        </div>

        <div class="col-lg-5">
            <div class="card">
                <div class="card-header">Marking</div>
                <div class="card-body">
                    {% for place in workflow_marked_places(task) %}
                        <p class="mb-3">
                            <span class="wf-place is-marked me-2">{{ place }}</span>
                            {{ workflow_metadata(task, 'description', place) }}
                        </p>
                    {% endfor %}
                    <p class="small text-secondary mb-0">
                        Stored in <code>App\Entity\Task::$marking</code> as the enum case
                        <code>TaskStep::{{ task.marking.name }}</code>.
                    </p>
                </div>
                <div class="card-footer bg-transparent">
                    <form action="{{ path('task_reset_marking', {id: task.id}) }}" method="post">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Reset the marking</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
