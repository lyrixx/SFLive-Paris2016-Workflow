{% macro flashbag() %}
    {% import _self as self %}
    {% for level in ['danger', 'warning', 'success', 'info'] %}
        {% for message in app.session.flashbag.get(level) %}
            {{ self.message(message, level) }}
        {% endfor %}
    {% endfor %}
{% endmacro %}

{% macro message(message, level = 'info') %}
    <div class="alert alert-{{ level }} alert-dismissible mb-4" role="alert">
        {{ message }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
{% endmacro %}
