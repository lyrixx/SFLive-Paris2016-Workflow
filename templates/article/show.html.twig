{% extends 'layout.html.twig' %}

{% block title %}{{ article.title }} · Articles · {{ parent() }}{% endblock %}

{% block band %}
    <section class="wf-band">
        <div class="container-xl py-5">
            <a class="wf-back small" href="{{ path('article_index') }}">← All articles</a>
            <p class="wf-kicker mt-4 mb-2">Workflow net · article #{{ article.id }} · {{ workflow_metadata(article, 'title') }}</p>
            <h1 class="wf-page-title mb-3">{{ article.title }}</h1>
            <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                <span class="wf-muted small">Current places</span>
                {% for place in workflow_marked_places(article) %}
                    <span class="wf-place is-marked">{{ place }}</span>
                {% endfor %}
            </div>
            <p class="wf-muted mb-0 col-lg-8">{{ workflow_metadata(article, 'description') }}</p>
        </div>
    </section>
{% endblock %}

{% block main %}
    <div class="card mb-4">
        <div class="card-header">Diagram</div>
        <div class="card-body">
            <div class="mermaid">
                {{- workflow_dump('article', 'workflow', article) -}}
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            {{ include('include/transitions.html.twig', {
                subject: article,
                workflow: 'article',
                action: path('article_apply_transition', {id: article.id}),
                hint_other_user: true,
            }) }}
        </div>

        <div class="col-lg-5">
            <div class="card">
                <div class="card-header">Marking</div>
                <div class="card-body">
                    {% for place in workflow_marked_places(article) %}
                        <div class="mb-3">
                            <span class="wf-place is-marked me-2">{{ place }}</span>
                            <strong>{{ workflow_metadata(article, 'title', place) }}</strong>
                            <div class="small text-secondary mt-1">{{ workflow_metadata(article, 'description', place) }}</div>
                        </div>
                    {% endfor %}
                    <p class="small text-secondary mb-0">
                        Stored in <code>App\Entity\Article::$marking</code> as
                        <code>{{ article.marking|json_encode }}</code>: one key per place, with its number of tokens.
                    </p>
                </div>
                <div class="card-footer bg-transparent">
                    <form action="{{ path('article_reset_marking', {id: article.id}) }}" method="post">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Reset the marking</button>
                    </form>
                </div>
            </div>

            <div class="card mt-4">
                <div class="card-header">Last transitions <small class="text-secondary fw-normal">(most recent first)</small></div>
                <div class="card-body">
                    <ol class="wf-timeline">
                        {% for transitionContext in article.transitionContexts|slice(-5)|reverse %}
                            <li>
                                <div class="small text-secondary">{{ transitionContext.time|date('Y-m-d H:i:s') }}</div>
                                <div class="d-flex flex-wrap gap-1 my-1">
                                    {% for place in transitionContext.new_marking|keys %}
                                        <span class="wf-place">{{ place }}</span>
                                    {% endfor %}
                                </div>
                                {% for key, value in transitionContext.context %}
                                    <div class="small"><span class="text-secondary">{{ key }}:</span> {{ value }}</div>
                                {% endfor %}
                            </li>
                        {% else %}
                            <li class="text-secondary">No transition applied yet.</li>
                        {% endfor %}
                    </ol>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
