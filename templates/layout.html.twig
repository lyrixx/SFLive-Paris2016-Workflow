{% import 'macros/flash.html.twig' as flash %}
<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Symfony Workflow demo{% endblock %}</title>
        <meta property="og:description" content="Create a task or an article, apply transitions, and see how markings, guards and metadata react.">
        <meta property="og:image" content="{{ absolute_url(asset('images/social-preview.png')) }}">
        <meta property="og:image:alt" content="Symfony Workflow: the diagram of the article workflow, where a draft splits into two parallel reviews that join to publish it.">
        <meta property="og:image:height" content="640">
        <meta property="og:image:type" content="image/png">
        <meta property="og:image:width" content="1280">
        <meta property="og:site_name" content="Symfony Workflow demo">
        <meta property="og:title" content="{{ block('title') }}">
        <meta property="og:type" content="website">
        <meta property="og:url" content="{{ absolute_url(app.request.pathInfo) }}">
        <meta name="twitter:card" content="summary_large_image">
        <link rel="icon" type="image/x-icon" href="{{ asset('favicon.ico') }}">
        {# Applying a transition redirects to the same page: Turbo morphs it instead of reloading it #}
        {{ turbo_refreshes_with(method: 'morph', scroll: 'preserve') }}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    </head>
    <body>
        {{ include('include/navbar.html.twig') }}

        {% block band %}{% endblock %}

        <main class="container-xl py-4 py-lg-5">
            {{ flash.flashbag() }}

            {% block main %}{% endblock %}
        </main>

        <footer class="wf-footer">
            <div class="container-xl py-4 d-flex flex-wrap gap-3 justify-content-between">
                <span>A demo of the <a href="https://symfony.com/doc/current/components/workflow.html">symfony/workflow</a> component.</span>
                <span>
                    <a href="https://github.com/lyrixx/SFLive-Paris2016-Workflow">Source code on GitHub</a>
                    · Hosted by <a href="https://www.clever-cloud.com/">Clever Cloud</a>
                </span>
            </div>
        </footer>
    </body>
</html>
