# Used by production builds (additional build context "app" pointing to the
# repository root, see the "Production stages" of
# infrastructure/docker/services/php/Dockerfile).
# Only source files needed at runtime should be sent to the build context.
.git
.github
.castor
.home
clevercloud
infrastructure
node_modules
tests
tools
var
vendor
.buildpacks
.editorconfig
.env.dev
.env.test
.gitattributes
.gitignore
.php-cs-fixer.php
*.md
app.json
castor.php
phpstan.neon
phpunit.dist.xml
phpunit.xml.dist
rector.php

# Local/generated files that must never end up baked into the image (some
# carry secrets, e.g. the prod secrets decryption key)
.castor.stub.php
.env.local
.env.local.php
.env.*.local
.php-cs-fixer.cache
.phpunit.cache
.phpunit.result.cache
.twig-cs-fixer.cache
phpunit.xml
config/reference.php
config/secrets/prod/prod.decrypt.private.php
public/assets
public/build
public/bundles
